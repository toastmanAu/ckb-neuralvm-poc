@@ -86,6 +87,11 @@ TEXT_ADDR, TEXT_ROW, TEXT_ROWS = 0x8000, 16, 128
 # the capture counter's thermometer weights are 8 * 2^m: m < 88 keeps them below bf16's max
 # after the emitter's 2^36 fold
