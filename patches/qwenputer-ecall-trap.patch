@@ -990,7 +990,9 @@ def build(target: Target | None = None, text=None) -> RvCore:
     fc = {0: c.and_([uops["ILLEGAL"]], "fault.0"), 1: c.and_([uops["EBREAK"]], "fault.1"),
           2: mis_ld, 3: mis_st, 4: oor_ld, 5: oor_st,
