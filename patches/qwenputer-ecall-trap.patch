     # ---------------------------------------------------------------- rd value, size, branch
     addish = any_of("ADD", "ADDI", "SUB")
@@ -1096,6 +1098,11 @@ def build(target: Target | None = None, text=None) -> RvCore:
     case([j3, ok, sbsh, EA[6]], "SS1")
     case(nr + [ecall, a7_is[1]], "BYTE", B[0:9])  # a byte, or (256..) a P3 special token
     case(nr + [ecall, a7_is[93]], "HALT")
+    # ckb-neuralvm trap patch: a jump to the fixed handler word. The payload must be given as
+    # bits (an int payload is dropped: only family ids are ints), here constants one / zero.
+    trap_word = [one if S.TRAP_WORD >> i & 1 else Expr() for i in range(16)]
+    for v in S.TRAP_CALLS:
+        case(nr + [ecall, a7_is[v]], "J", trap_word)
     case(nr + [uops["FENCE"]], "NT")
     # digit-file ops: BD per digit (j < n), then rd = the last carry (or NT)
     for start in ([j0, one - at_max], [one - j0]):
